{
  "name": "wdd430-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint",
